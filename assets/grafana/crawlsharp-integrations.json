            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (crawlsharp_integration_service) (rate(crawlsharp_integration_requests_total{crawlsharp_outcome=~\"failure|timeout|server_error\"}[5m])) / clamp_min(sum by (crawlsharp_integration_service) (rate(crawlsharp_integration_requests_total[5m])), 1e-9)",
          "legendFormat": "{{crawlsharp_integration_service}}",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      }
