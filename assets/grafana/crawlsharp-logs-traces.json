{
  "uid": "crawlsharp-logs-traces",
  "title": "CrawlSharp / Logs and Traces",
  "description": "Recent crawl traces from Tempo and server logs from Loki. Logs carry trace_id, so a log line links to its trace.",
  "tags": [
    "crawlsharp",
    "logs",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "CrawlSharp",
      "type": "dashboards",
      "tags": [
        "crawlsharp"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Traces",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Recent crawls",
      "description": "Root crawl spans. Open one to see robots, sitemap, page, stage and HTTP client spans.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"crawlsharp-server\" && name = \"crawl\" }",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Failed spans",
      "description": "Any span with error status.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"crawlsharp-server\" && status = error }",
          "limit": 50,
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 11
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Warnings",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"crawlsharp-server\"} | severity_text=~\"(?i)warn.*|error|critical\"",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "logs",
      "title": "All server logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"crawlsharp-server\"}",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 32
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
