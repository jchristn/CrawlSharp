    {
      "type": "row",
      "title": "Build",
      "id": 8,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Build and configuration",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "otel_scope_name": true,
              "otel_scope_version": true,
              "job": true
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "crawlsharp_server_build_info or crawlsharp_server_config_info",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      }
