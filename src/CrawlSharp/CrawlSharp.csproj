<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Version>1.2.2</Version>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>CrawlSharp.xml</DocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>CrawlSharp is a library useful for crawling web endpoints to identify structure and retrieve contents.</Title>
		<Authors>Joel Christner</Authors>
		<Description>CrawlSharp is a library useful for crawling web endpoints to identify structure and retrieve contents.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/CrawlSharp</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/CrawlSharp</RepositoryUrl>
		<RepositoryType>github</RepositoryType>
		<PackageTags>web crawl crawler opentelemetry metrics tracing</PackageTags>
		<PackageReleaseNotes>1.2.2: a click that times out during headless auto-expand is skipped instead of failing the page; dependencies updated (Microsoft.Playwright 1.63.0, HtmlAgilityPack 1.13.0, SerializationHelper 2.1.0). 1.2.1: requests to crawled sites no longer carry W3C trace context (traceparent/tracestate) headers. 1.2.0: built-in observability: CrawlSharp emits metrics and traces through the BCL Meter and ActivitySource named "CrawlSharp" (crawl jobs, every pipeline stage, pages, links, redirects, outbound HTTP and Playwright calls, queue and worker gauges, errors by type). Near-zero cost until a host subscribes; no exporter dependency. Names are in CrawlSharp.Telemetry.CrawlSharpTelemetry and documented in TELEMETRY.md. Also fixes a worker-slot over-release after a failed page.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="icon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\assets\icon.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\LICENSE.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="HtmlAgilityPack" Version="1.13.0" />
	  <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
	  <PackageReference Include="RestWrapper" Version="3.3.1" />
	  <PackageReference Include="SerializationHelper" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="public_suffix_list.dat.txt">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
